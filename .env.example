# PDFBright environment template
# Keep secrets server-only. Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Search / ownership verification
# Optional: use the verification token supplied by Google Search Console for a URL-prefix property.
# A Domain property verified through DNS does not need this value.
GOOGLE_SITE_VERIFICATION=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallback during migration only:
# SUPABASE_SERVICE_ROLE_KEY=

# Billing availability
# Keep both flags false/absent for the free Early Access launch. Re-enable only after live billing is approved and re-tested.
BILLING_ENABLED=false
NEXT_PUBLIC_BILLING_ENABLED=false

# Paddle billing
# Use Sandbox values in local/Vercel Preview until the full checkout -> webhook -> Pro flow is proven.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_MONTHLY_PRICE_ID=
PADDLE_YEARLY_PRICE_ID=

# Paddle.js client-side tokens are intentionally public credentials for checkout.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# PostHog analytics
# Public project values only. PDFBright intentionally disables autocapture and session replay.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
