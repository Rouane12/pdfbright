# PDFBright environment template
# Keep secrets server-only. Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallback during migration only:
# SUPABASE_SERVICE_ROLE_KEY=

# Lemon Squeezy billing
# Validate test-mode billing in Vercel Preview before copying live values into Production.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_MONTHLY_VARIANT_ID=
LEMON_SQUEEZY_YEARLY_VARIANT_ID=
# Set true only while using Lemon Squeezy test-mode products/checkouts.
LEMON_SQUEEZY_TEST_MODE=false

# Analytics (post-launch setup)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
